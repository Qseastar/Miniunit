# IntroAI Tutor local configuration template.
# Copy to .env and fill only the values needed for your local run.
# The application never loads .env itself; export these values in the shell.

# Optional for course-grounded free-form QA. Leave empty for deterministic-only demo.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2

# Optional local runtime overrides.
INTROAI_STATE_DB=
INTROAI_COURSE_MATERIALS_DIR=

# Pilot mode is off by default. Keep this off for the competition demo.
INTROAI_PILOT_MODE=0
INTROAI_PILOT_ACCESS_CODE=
INTROAI_PILOT_HOST=127.0.0.1
