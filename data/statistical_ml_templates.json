      "choices": [
        {
          "id": "overfitting",
          "text": "模型变得复杂，容易过拟合"
        },
        {
          "id": "underfitting",
          "text": "模型过于简单，欠拟合"
        },
        {
          "id": "no_effect",
          "text": "对模型没有影响"
        },
        {
          "id": "always_better",
          "text": "一定提高泛化性能"
        }
      ],
      "expected_answer": {
        "choice_id": "overfitting"
      },
      "deterministic_scorer": "single_choice_v1",
      "misconception_rules": [],
      "teaching_support": {
        "hint": "回顾课件：较小的 k 相当于用较小的邻域预测，训练误差减小，泛化误差会怎样变化？",
        "explanation": "k 减小意味着模型变得更复杂，训练误差减小但泛化误差增大，容易过拟合；k 增大（直至 k=N）则模型过于简单。"
      },
      "benchmark_case_ids": [
        "stat_ml_knn_k_correct",
        "stat_ml_knn_k_wrong"
      ]
    },
    {
      "id": "verify_knn_manhattan_distance_v1",
      "schema_version": 1,
      "review_status": "human_verified",
      "purpose": "mastery_verification",
      "concept_ids": [
        "statistical_ml__knn_distance_metric"
      ],
      "eligible_intents": [
        "diagnostic_request",
        "algorithm_trace"
      ],
      "selection_priority": 200,
      "question_type": "numeric_answer",
      "prompt": "二维空间中，两点 x=(1,1) 与 x'=(4,5) 的曼哈顿距离（闵可夫斯基距离 p=1）等于多少？",
      "choices": [],
      "expected_answer": {
        "value": 7,
        "absolute_tolerance": 0.01
      },
      "deterministic_scorer": "numeric_answer_v1",
      "misconception_rules": [],
      "teaching_support": {
        "hint": "曼哈顿距离是各维坐标差绝对值之和：|4−1| + |5−1|。",
        "explanation": "曼哈顿距离（p=1）为 Σ|xi − xi'| = |4−1| + |5−1| = 3 + 4 = 7。注意欧氏距离（p=2）是 5，不要混淆。"
      },
      "benchmark_case_ids": [
        "stat_ml_knn_manhattan_correct",
        "stat_ml_knn_manhattan_wrong"
      ]
    },
    {
      "id": "verify_linear_regression_least_squares_objective_v1",
      "schema_version": 1,
