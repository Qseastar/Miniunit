      "selection_priority": 250,
      "question_type": "ordering",
      "prompt": "请将 K 均值（K-Means）聚类的执行步骤按正确顺序排列。",
      "choices": [
        {
          "id": "update",
          "text": "更新各簇的均值向量，将其作为新的簇中心"
        },
        {
          "id": "init",
          "text": "随机选取 k 个样本点作为簇中心"
        },
        {
          "id": "check",
          "text": "若所有簇中心未发生改变则停止，否则回到划分步骤"
        },
        {
          "id": "assign",
          "text": "将其他样本点根据其与簇中心的距离，划分给最近的簇"
        }
      ],
      "expected_answer": {
        "ordered_choice_ids": [
          "init",
          "assign",
          "update",
          "check"
        ]
      },
      "deterministic_scorer": "ordering_v1",
      "misconception_rules": [],
      "teaching_support": {
        "hint": "回想 K-Means 的迭代：先选中心，再分配样本，再更新均值，最后判断是否收敛。",
        "explanation": "正确顺序为：①随机选 k 个簇中心 → ②按距离把样本划分给最近的簇 → ③更新各簇均值作为新中心 → ④判断是否停止，未停止则回到②。"
      },
      "benchmark_case_ids": [
        "stat_ml_kmeans_order_correct",
        "stat_ml_kmeans_order_wrong"
      ]
    },
