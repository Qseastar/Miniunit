      "selection_priority": 300,
      "question_type": "single_choice",
      "prompt": "一元线性回归 f(x)=wx+b 中，最小二乘法（least square method）的优化目标是？",
      "choices": [
        {
          "id": "min_mse",
          "text": "最小化预测值与真实值之差的平方和（均方误差）"
        },
        {
          "id": "min_abs",
          "text": "最小化预测值与真实值之差的绝对值之和"
        },
        {
          "id": "max_likelihood",
          "text": "最大化样本的似然"
        },
        {
          "id": "min_param",
          "text": "最小化参数 w 和 b 的绝对值"
        }
      ],
      "expected_answer": {
        "choice_id": "min_mse"
      },
      "deterministic_scorer": "single_choice_v1",
      "misconception_rules": [],
      "teaching_support": {
        "hint": "回顾课件：均方误差（MSE）对应的优化目标是什么？",
        "explanation": "最小二乘法最小化均方误差，即 Σ(yi − f(xi))²，对应『差的平方和』，而不是绝对值之和（那是 L1 损失）。"
      },
      "benchmark_case_ids": [
        "stat_ml_linear_least_squares_correct",
        "stat_ml_linear_least_squares_wrong"
      ]
    },
    {
      "id": "verify_linear_regression_closed_form_intercept_v1",
